{
    "name": "restropulse-pwa-backend",
    "version": "1.0.0",
    "description": "Backend API for RestroPulse PWA",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "type-check": "tsc --noEmit",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --runInBand",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
        "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=unit --runInBand",
        "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=integration --runInBand",
        "db:seed": "cd ../restropulse-pwa-database && npm run seed:clean"
    },
    "keywords": [
        "restropulse",
        "api",
        "backend"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.13.2",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "firebase-admin": "^13.6.0",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^6.12.0",
        "node-cron": "^4.2.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.14.0",
        "@types/node-cron": "^3.0.11",
        "@types/supertest": "^6.0.2",
        "jest": "^29.7.0",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "tsx": "^4.7.0",
        "typescript": "~5.8.2"
    }
}
