{
  "name": "restropulse",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered social media management platform for restaurants",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "// --- App ---": "",
    "ports:check": "node scripts/free-ports.mjs --check",
    "ports:free": "node scripts/free-ports.mjs --force",
    "ports:check:dev": "node scripts/free-ports.mjs --check",
    "ports:free:dev": "node scripts/free-ports.mjs --force",
    "dev": "turbo run dev --filter=!@restropulse/db-cli",
    "dev:check": "npm run ports:check:dev && npm run dev",
    "dev:free": "npm run ports:free:dev && npm run dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:unit": "turbo run test:unit --filter=@restropulse/api --filter=@restropulse/web --filter=@restropulse/publisher --filter=@restropulse/content-engine",
    "test:coverage": "node scripts/run-coverage-all.mjs",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "// --- AI Tooling ---": "",
    "setup:mcp": "node scripts/setup-mcp.mjs",
    "setup:rtk": "node scripts/setup-rtk.mjs",
    "reindex": "node scripts/reindex-rag.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.2.0",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.0.0"
}
