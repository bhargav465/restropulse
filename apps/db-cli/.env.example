# RestroPulse DB CLI - Environment Variables
# Copy to .env and fill in real values, OR pass as shell env vars.

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=restropulsev1

# Base URL for media URLs embedded in seeded post data.
# Local development (API must be running on port 3001):
CONTENT_BASE_URL=http://localhost:3001/content/mockdata
# Staging (pass via shell before running seed command):
# CONTENT_BASE_URL=https://restropulse-prod-api-staging.azurewebsites.net/content/mockdata
# Production:
# CONTENT_BASE_URL=https://restropulse-prod-api.azurewebsites.net/content/mockdata
